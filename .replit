modules = ["php-8.2", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["php82Extensions.pdo_mysql", "php82Extensions.pdo_pgsql"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PHP Server"

[[workflows.workflow]]
name = "PHP Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./start.sh"
waitForPort = 5000

[deployment]
run = ["sh", "-c", "./start.sh"]

[[ports]]
localPort = 5000
externalPort = 80
